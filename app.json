{
  "expo": {
    "name": "Xoeat",
    "slug": "xoeat-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xoeat",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "bundleIdentifier": "app.xoeat.customer", "supportsTablet": false },
    "android": {
      "package": "app.xoeat.customer",
      "adaptiveIcon": { "backgroundColor": "#FFFFFF", "foregroundImage": "./assets/images/android-icon-foreground.png" },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Xoeat | 오늘 뭐 먹지, 간편하게 주문.",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#FFFFFF", "image": "./assets/images/splash-icon.png", "imageWidth": 96 }]
    ]
  }
}
